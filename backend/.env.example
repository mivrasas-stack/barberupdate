# Backend only. Never place secrets in frontend VITE_* environment variables.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://barberos_api:CHANGE_ME@DB_HOST:5432/postgres?sslmode=require
DATABASE_POOL_MAX=8
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_KEY
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=90
MEDIA_BUCKET=barberos-images
PUBLIC_API_PORT=8188

# WhatsApp Cloud API: SOLO ENVIO. Nunca añadir credenciales a VITE_*.
# La ruta POST /{PHONE_NUMBER_ID}/messages usa token + Phone Number ID.
# WABA ID es opcional para administrar la cuenta, NO para enviar cada mensaje.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_SEND_ENABLED=false
# No registrar ni publicar webhooks en modo solo envío.
WHATSAPP_WEBHOOK_ENABLED=false
