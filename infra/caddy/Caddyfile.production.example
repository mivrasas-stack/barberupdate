{
  email {$ACME_EMAIL}
}

{$BARBEROS_API_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }
  handle /api/* {
    reverse_proxy api1:8080 api2:8080 {
      # For direct HTTPS client connections; adjust trusted proxies if a CDN/LB is introduced.
      header_up X-Forwarded-For {remote_host}
      lb_policy least_conn
      health_uri /api/v1/health/ready
      health_interval 10s
      health_timeout 4s
      fail_duration 30s
      max_fails 1
      lb_try_duration 5s
      lb_try_interval 250ms
    }
  }
  handle {
    respond "BarberOS backend only" 404
  }
}
