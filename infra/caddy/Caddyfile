{
  auto_https off
}
:80 {
  encode zstd gzip
  handle /api/* {
    reverse_proxy api1:8080 api2:8080 {
      lb_policy least_conn
      # Route traffic only to replicas able to reach PostgreSQL and Redis.
      health_uri /api/v1/health/ready
      health_interval 10s
      health_timeout 4s
      # Passive detection prevents waiting for the next active health probe.
      fail_duration 30s
      max_fails 1
      lb_try_duration 5s
      lb_try_interval 250ms
    }
  }
  handle {
    respond "BarberOS API only; frontend deliberately not integrated" 404
  }
}
